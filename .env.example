# HALO — example environment variables.
# Copy to .env for local dev, or set these in Netlify → halo-frame → Environment.
# NEVER commit real secrets. This file documents names only.

# ---------------------------------------------------------------------------
# Stripe payments — DORMANT / PRE-WIRED.
#
# HALO ships with payments OFF. Leave everything in this block UNSET (or false)
# until launch. With STRIPE_ENABLED unset/false, NOTHING charges, no Stripe
# network calls happen, and the app builds and runs exactly as before.
#
# To ACTIVATE later: set STRIPE_ENABLED=true, add STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET, fill in the STRIPE_PRICE_* ids from your Stripe
# dashboard, and set VITE_STRIPE_ENABLED=true so the pay UI appears.
# ---------------------------------------------------------------------------

# Master switch for the SERVER functions. "true" turns payments on.
# Leave unset / false until launch.
STRIPE_ENABLED=false

# Stripe secret key (sk_live_... or sk_test_...). Leave unset until launch.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (whsec_...). From the Stripe
# dashboard → Developers → Webhooks → your endpoint. Leave unset until launch.
STRIPE_WEBHOOK_SECRET=

# Stripe PRICE IDs (price_...), one per marketing tier. Prices are NEVER
# hardcoded in code — only these ids are read from env. Create the products
# and prices in Stripe, then paste the price ids here. Leave unset until launch.
# Per-event (one-time) tiers:
STRIPE_PRICE_STARTER=       # Starter — $29 / event
STRIPE_PRICE_EVENT=         # Event — $79 / event
STRIPE_PRICE_PREMIER=       # Premier — $149 / event
# Subscription (monthly) tiers:
STRIPE_PRICE_HOST=          # Host — $19 / month
STRIPE_PRICE_PRO=           # Pro — $49 / month
STRIPE_PRICE_STUDIO=        # Studio — $99 / month

# Master switch for the BROWSER / pay UI. "true" shows pay buttons.
# Leave unset / false until launch.
VITE_STRIPE_ENABLED=false
